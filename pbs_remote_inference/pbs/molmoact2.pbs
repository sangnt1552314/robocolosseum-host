#!/bin/bash
#PBS -P CFP05-SF-002
#PBS -j oe
#PBS -N colosseum-molmoact2
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:10:00

# Serve one molmoact2 checkpoint over HTTP for Colosseum Policy Server. From the repo root:
#   qsub -v EMBODIMENT=<so101|yam|franka> pbs_remote_inference/pbs/molmoact2.pbs
#   qsub -v EMBODIMENT=<so101|yam|franka>,PORT=9101 -l walltime=04:00:00 pbs_remote_inference/pbs/molmoact2.pbs
# Container + venv: see serve.sh. Several families on one GPU: see cohost.pbs.
# Reachable from outside: add TUNNEL=tailscale (http://colosseum-<robot>-molmoact2:<port>) or TUNNEL=cloudflare.

cd "${PBS_O_WORKDIR:-.}"
[ -n "$EMBODIMENT" ] || { echo "ERROR: set EMBODIMENT (so101|yam|franka) with qsub -v EMBODIMENT=..." >&2; exit 1; }
module load singularity
TS_HOSTNAME=${TS_HOSTNAME:-colosseum-$EMBODIMENT-molmoact2}
[ "$TUNNEL" = tailscale ] && source pbs_remote_inference/pbs/tailscale.sh
bash pbs_remote_inference/pbs/serve.sh molmoact2 "$EMBODIMENT" "${PORT:-9101}"
