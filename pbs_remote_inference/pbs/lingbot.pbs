#!/bin/bash
#PBS -P CFP05-CF-002
#PBS -j oe
#PBS -k oed
#PBS -N pbsri-lingbot
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:00:00

# GPU inference WORKER for lingbot (default embodiment: so101). See molmoact2.pbs for full notes.

cd $PBS_O_WORKDIR

if [ -z "$SESSION_ID" ] || [ -z "$MODEL" ] || [ -z "$CALLBACK_URL" ] || [ -z "$CALLBACK_TOKEN" ]; then
    echo "ERROR: SESSION_ID, MODEL, CALLBACK_URL and CALLBACK_TOKEN must be set." >&2
    exit 1
fi

# Embodiment + task select the worker config under pbs_remote_inference/configs/.
# Default to so101; the launcher can override with qsub -v EMBODIMENT=...,TASK=...
EMBODIMENT="${EMBODIMENT:-so101}"
TASK="${TASK:-stack_white_bowls_100episodes}"

image="/app1/common/singularity-img/hopper/pytorch/pytorch_2.6.0_cuda_12.8.sif"

module load singularity

LOG_DIR="./logs/pbs_remote_inference/${EMBODIMENT}/lingbot"
mkdir -p $LOG_DIR

singularity exec -e --nv \
--env HF_HOME=/scratch/e1583535/cache \
--env HF_HUB_OFFLINE=1 \
--env TMPDIR=/scratch/e1583535/tmp \
--env TEMP=/scratch/e1583535/tmp \
--env TMP=/scratch/e1583535/tmp \
--env SESSION_ID="$SESSION_ID" \
--env MODEL="$MODEL" \
--env CALLBACK_URL="$CALLBACK_URL" \
--env CALLBACK_TOKEN="$CALLBACK_TOKEN" \
--env EMBODIMENT="$EMBODIMENT" \
--env TASK="$TASK" \
$image bash << 'EOF' > $LOG_DIR/stdout.$PBS_JOBID.log 2> $LOG_DIR/stderr.$PBS_JOBID.log

mkdir -p /scratch/e1583535/tmp

if [ -d "/scratch/e1583535/virtualenvs/lingbot-vla-v2" ]; then
    source /scratch/e1583535/virtualenvs/lingbot-vla-v2/bin/activate
fi

echo "Starting inference worker at $(date) on host $(hostname)"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader,nounits || echo "No GPU detected"

python pbs_remote_inference/worker/run_worker.py \
    --model "$MODEL" \
    --server "$CALLBACK_URL" \
    --token "$CALLBACK_TOKEN" \
    --session-id "$SESSION_ID" \
    --config "pbs_remote_inference/configs/${EMBODIMENT}/${TASK}/lingbot_vla_v2.yaml"

echo "Inference worker ended at $(date)"
EOF
