#!/bin/bash
#PBS -P CFP05-SF-002
#PBS -j oe
#PBS -N colosseum-lingbot
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:00:00

# Serve one lingbot checkpoint over HTTP for Colosseum Policy Server. From the repo root:
#   qsub -v EMBODIMENT=<yam|so101> pbs_remote_inference/pbs/lingbot.pbs
#   qsub -v EMBODIMENT=<yam|so101>,PORT=9101 -l walltime=04:00:00 pbs_remote_inference/pbs/lingbot.pbs
# Container + venv: see serve.sh. Several families on one GPU: see cohost.pbs.
# Reachable from outside: add TUNNEL=tailscale (http://colosseum-<robot>-lingbot:<port>) or TUNNEL=cloudflare.

cd "${PBS_O_WORKDIR:-.}"
[ -n "$EMBODIMENT" ] || { echo "ERROR: set EMBODIMENT (yam|so101) with qsub -v EMBODIMENT=..." >&2; exit 1; }
module load singularity
TS_HOSTNAME=${TS_HOSTNAME:-colosseum-$EMBODIMENT-lingbot}
[ "$TUNNEL" = tailscale ] && source pbs_remote_inference/pbs/tailscale.sh
bash pbs_remote_inference/pbs/serve.sh lingbot "$EMBODIMENT" "${PORT:-9101}"
