# Copy to nscc_pbs_remote_inference/.env (git-ignored) and fill in.
# Reusable + ephemeral Tailscale auth key; needed only with TUNNEL=tailscale.
TS_AUTHKEY=tskey-auth-REPLACE_ME
# Optional Tailscale API access token: lets a job delete the offline device a killed job left
# behind, so it keeps the name colosseum-<robot> instead of colosseum-<robot>-1.
# TS_API_KEY=tskey-api-REPLACE_ME

# Only with TUNNEL=ngrok:
# NGROK_AUTHTOKEN=
# NGROK_BASIC_AUTH=user:password
